#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Manual prune wrapper. Intentionally NOT scheduled — append-only is the
# default, prune runs use a separate non-append-only key. Run by hand when
# retention drift becomes visible.

set -euo pipefail

export BORG_REPO="{{ borg_backup_repo }}"
export BORG_PASSCOMMAND="cat {{ borg_backup_secrets_dir }}/passphrase"
export BORG_KEY_FILE="{{ borg_backup_keyfile_path }}"
export BORG_RSH="ssh -p {{ borg_backup_ssh_port }} -i {{ borg_backup_ssh_private_key_path }} -o UserKnownHostsFile={{ borg_backup_known_hosts_path }} -o StrictHostKeyChecking=yes -o BatchMode=yes -o PasswordAuthentication=no -o ServerAliveInterval=60 -o ServerAliveCountMax=10"

borg prune \
  --list \
  --stats \
  --keep-daily   {{ borg_backup_prune_keep_daily }} \
  --keep-weekly  {{ borg_backup_prune_keep_weekly }} \
  --keep-monthly {{ borg_backup_prune_keep_monthly }} \
  --keep-yearly  {{ borg_backup_prune_keep_yearly }}

borg compact
